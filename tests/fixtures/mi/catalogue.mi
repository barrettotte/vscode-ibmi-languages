/********************************************************************/
/* Every instruction the reference gives an operand count for, written */
/* with that many operands. The count comes from the op-code table in */
/* the reference rather than from guesswork.                        */
/********************************************************************/
/* Member: MICAT                                                    */
/* Compilable: no - an instruction catalogue, not a working program. */
/* Source: IBM i 7.5 Machine Interface functional reference.        */
/* Retrieved: 2026-07-28                                            */
/********************************************************************/

/* The operands these instructions take are declared once and       */
/* reused, so that the instruction name is what varies.             */
DCL     DD         R            PKD(15,5)  AUTO;
DCL     DD         A            PKD(15,5)  AUTO;
DCL     DD         B            PKD(15,5)  AUTO;
DCL     DD         C            PKD(15,5)  AUTO;

/********************************************************************/
/* Instructions the reference gives no operands.                    */
        CLRIEXIT;
        END;
        NOOP;
        YIELD;
