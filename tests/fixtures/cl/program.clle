/*                                                                           */
/* A CL program of the kind a shop writes: it takes parameters, opens         */
/* a file, drives a read loop, calls other objects and handles its own        */
/* errors. Every control statement the language has appears in it.            */
/*                                                                           */
/* Member: ORDDRV   Compilable: yes (CRTBNDCL), but the objects it            */
/*         names are not created here                                         */
/* Source: IBM i 7.5 Control Language.                                        */
/* Retrieved: 2026-07-28                                                      */
/*                                                                           */
/*                                                                           */
/* The program statement and its parameters.                                  */
             PGM        PARM(&LIB &FROMDATE &THRUDATE)

/*  Parameters, then the variables the program works with.                    */
             DCL        VAR(&LIB)      TYPE(*CHAR) LEN(10)
             DCL        VAR(&FROMDATE) TYPE(*CHAR) LEN(8)
             DCL        VAR(&THRUDATE) TYPE(*CHAR) LEN(8)

             DCL        VAR(&COUNT)    TYPE(*DEC)  LEN(7 0) VALUE(0)
             DCL        VAR(&TOTAL)    TYPE(*DEC)  LEN(11 2) VALUE(0)
             DCL        VAR(&MSGID)    TYPE(*CHAR) LEN(7)
             DCL        VAR(&MSGDTA)   TYPE(*CHAR) LEN(256)
             DCL        VAR(&MSGF)     TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSGFLIB)  TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSGKEY)   TYPE(*CHAR) LEN(4)
             DCL        VAR(&TEXT)     TYPE(*CHAR) LEN(80)
             DCL        VAR(&DONE)     TYPE(*LGL)  VALUE('0')
             DCL        VAR(&IDX)      TYPE(*INT)  LEN(4)
             DCL        VAR(&PTR)      TYPE(*PTR)
             DCL        VAR(&BUFFER)   TYPE(*CHAR) LEN(256)

/*  A declared file supplies the variables its fields become.                 */
             DCLF       FILE(&LIB/ORDHDR) RCDFMT(ORDREC)

/*                                                                           */
/*  Procedure options, and a global monitor that catches anything             */
/*  a command below does not catch for itself.                                */
             DCLPRCOPT  LOG(*YES)
             MONMSG     MSGID(CPF0000 MCH0000) EXEC(GOTO CMDLBL(ERROR))

/*                                                                           */
/*  Defaults. A parameter left blank takes the value of a system              */
/*  value or of the job itself.                                               */
             IF         COND(&LIB *EQ ' ') THEN(DO)
             RTVJOBA    CURLIB(&LIB)
             IF         COND(&LIB *EQ '*NONE') THEN(CHGVAR VAR(&LIB) +
                           VALUE('QGPL'))
             ENDDO

             IF         COND(&FROMDATE *EQ ' ') THEN(DO)
             RTVSYSVAL  SYSVAL(QDATE) RTNVAR(&FROMDATE)
             CHGVAR     VAR(&THRUDATE) VALUE(&FROMDATE)
             ENDDO

/*                                                                           */
/*  Built-in functions: a substring, a scan, a trim and a                     */
/*  conversion, then the address and offset of a variable.                    */
             CHGVAR     VAR(&TEXT) VALUE(%SST(&FROMDATE 1 4))
             CHGVAR     VAR(&IDX)  VALUE(%SCAN('-' &FROMDATE))
             CHGVAR     VAR(&TEXT) VALUE(%TRIM(&TEXT) *BCAT %TRIMR(&LIB))
             CHGVAR     VAR(&TEXT) VALUE(%UPPER(%LOWER(&TEXT)))
             CHGVAR     VAR(&COUNT) VALUE(%DEC(&IDX 7 0))
             CHGVAR     VAR(&IDX)  VALUE(%INT(&COUNT) + %LEN(&TEXT))
             CHGVAR     VAR(&IDX)  VALUE(%CHECK('0123456789' &FROMDATE))
             CHGVAR     VAR(&IDX)  VALUE(%CHECKR(' ' &TEXT))
             CHGVAR     VAR(&PTR)  VALUE(%ADDR(&BUFFER))
             CHGVAR     VAR(&IDX)  VALUE(%OFFSET(&PTR) + %SIZE(&BUFFER))
             CHGVAR     VAR(&BUFFER) VALUE(%BINARY(&IDX))
             IF         COND(%SWITCH(1XXXXXXX)) THEN(CHGVAR VAR(&DONE) +
                           VALUE('1'))

/*                                                                           */
/*  The read loop. RCVF sets the end-of-file message, which the               */
/*  monitor on the command itself turns into the loop's exit.                 */
             OVRDBF     FILE(ORDHDR) TOFILE(&LIB/ORDHDR) SHARE(*YES)
             DOWHILE    COND(*NOT &DONE)
             RCVF
             MONMSG     MSGID(CPF0864) EXEC(LEAVE)

             IF         COND(&ORDDAT *LT &FROMDATE *OR &ORDDAT *GT +
                           &THRUDATE) THEN(ITERATE)

             CHGVAR     VAR(&COUNT) VALUE(&COUNT + 1)
             CHGVAR     VAR(&TOTAL) VALUE(&TOTAL + &ORDAMT)
             ENDDO
             DLTOVR     FILE(ORDHDR)

/*                                                                           */
/*  A counted loop and a loop that tests at the end.                          */
             DOFOR      VAR(&IDX) FROM(1) TO(12) BY(1)
             IF         COND(&IDX *EQ 6) THEN(ITERATE)
             IF         COND(&IDX *GT 10) THEN(LEAVE)
             ENDDO

             DOUNTIL    COND(&COUNT *LE 0)
             CHGVAR     VAR(&COUNT) VALUE(&COUNT - 1)
             ENDDO

/*                                                                           */
/*  A select group, and the plain DO that a THEN may open.                    */
             SELECT
             WHEN       COND(&TOTAL *EQ 0) THEN(DO)
             CHGVAR     VAR(&TEXT) VALUE('No orders in range')
             ENDDO
             WHEN       COND(&TOTAL *LT 1000) THEN(CHGVAR VAR(&TEXT) +
                           VALUE('Below threshold'))
             OTHERWISE  CMD(CHGVAR VAR(&TEXT) VALUE('Reportable'))
             ENDSELECT

/*                                                                           */
/*  Calling other objects: a program, a bound procedure, and a                */
/*  command run from a character string.                                      */
             CALL       PGM(&LIB/ORDPOST) PARM(&LIB &COUNT &TOTAL)
             CALLPRC    PRC('order_total') PARM(&TOTAL) RTNVAL(&IDX)
             CALL       PGM(QCMDEXC) PARM('DSPLIBL OUTPUT(*PRINT)' 24)
             TFRCTL     PGM(&LIB/ORDNEXT)

/*                                                                           */
/*  Messages sent and received.                                               */
             SNDPGMMSG  MSG('Processed' *BCAT %CHAR(&COUNT) *BCAT +
                           'orders') MSGTYPE(*INFO)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&TEXT) +
                           MSGTYPE(*COMP)
             RCVMSG     MSGTYPE(*LAST) RMV(*NO) MSGDTA(&MSGDTA) +
                           MSGID(&MSGID) MSGF(&MSGF) MSGFLIB(&MSGFLIB) +
                           MSGKEY(&MSGKEY)

             RETURN

/*                                                                           */
/*  The error section, reached by the global monitor. It resends              */
/*  the message it was given and ends the program.                            */
ERROR:       RCVMSG     MSGTYPE(*EXCP) RMV(*YES) MSGDTA(&MSGDTA) +
                           MSGID(&MSGID) MSGF(&MSGF) MSGFLIB(&MSGFLIB)
             SNDPGMMSG  MSGID(&MSGID) MSGF(&MSGFLIB/&MSGF) +
                           MSGDTA(&MSGDTA) MSGTYPE(*ESCAPE)
             MONMSG     MSGID(CPF0000)

             ENDPGM
