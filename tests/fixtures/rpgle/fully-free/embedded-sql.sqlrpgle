**FREE
//
// Embedded SQL in fully free-form RPG. EXEC SQL opens the statement,
// a semicolon closes it, and host variables carry a leading colon.
//
// Member: FREESQL   Compilable: no (calculations only, no files)
// Source: IBM i 7.5 Embedded SQL programming, embedding SQL statements
//         in ILE RPG applications that use SQL.
// Retrieved: 2026-07-27
//
//
// Options and the communications area.
exec sql set option commit = *none, closqlcsr = *endmod;
exec sql include sqlca;
//
// Host variables and structures carry a colon.
dcl-s custNbr packed(7 : 0);
dcl-s custNm char(30);
dcl-s custBal packed(11 : 2);
dcl-s nullInd int(5);
dcl-ds custRow qualified;
  name char(30);
  balance packed(11 : 2);
end-ds;
//
// A single-row select. An indicator variable follows the host
// variable it belongs to.
exec sql
  select cusnam, cusbal
    into :custNm, :custBal :nullInd
    from custmast
   where cusnbr = :custNbr;
//
// Selecting into a host structure.
exec sql
  select cusnam, cusbal into :custRow
    from custmast where cusnbr = :custNbr;
//
// Names may be qualified by schema, with either a dot or a slash.
exec sql select count(*) into :rowCount from mylib.custmast;
exec sql select count(*) into :rowCount from mylib/custmast;
//
// A cursor, from declaration through to close.
exec sql
  declare custCursor cursor for
    select cusnbr, cusnam, cusbal
      from custmast
     where cusbal > :minBalance
     order by cusbal desc
     for read only;
exec sql open custCursor;
dow sqlcode = 0;
  exec sql fetch next from custCursor
    into :custNbr, :custNm, :custBal;
  if sqlcode <> 0;
    leave;
  endif;
enddo;
exec sql close custCursor;
//
// Changing rows.
exec sql
  insert into custmast (cusnbr, cusnam, cusbal)
       values (:custNbr, :custNm, :custBal);
exec sql
  update custmast set cusbal = cusbal * 1.05
   where cusnbr = :custNbr and cusbal >= 100.00;
exec sql delete from custmast where cusnbr = :custNbr;
exec sql commit;
exec sql rollback;
//
// Functions, literals and the operators an expression may use.
exec sql
  select upper(trim(cusnam)), coalesce(cusbal, 0)
    into :custNm, :custBal
    from custmast
   where cusnam like 'A%'
     and cusbal <> 0 and cusbal >= 10.5
     and status in ('A', 'B')
     and code = x'F1F2';
//
// The global variables the precompiler recognises.
exec sql
  select job_name, client_ipaddr into :jobName, :clientIp
    from sysibm.sysdummy1;
//
// Error handling. WHENEVER sets what happens on a condition.
exec sql whenever sqlerror goto sqlFail;
exec sql whenever not found continue;
exec sql whenever sqlwarning continue;
//
// All three comment forms are allowed inside a statement: SQL's
// own double hyphen, the ordinary // of free-form RPG, and a
// bracketed comment, which may span lines.
exec sql
  select cusnam            -- the customer name
    into :custNm           // an RPG comment reads too
    from custmast          /* and a bracketed one,
                              running over two lines */
   where cusnbr = :custNbr;
//
// A statement may also be written on one line.
exec sql select cusnam into :custNm from custmast; // after
//
// Grouping, with the column list broken over several lines and
// an SQL comment on the last clause. A -- comment is only an SQL
// comment inside the statement, so the terminator goes on its own
// line; written after the ; it would be two minus signs in RPG.
exec sql
    SELECT my_id
    FROM MY_TABLE
    GROUP BY RRCLTP,rrclm#,
      poltp2,
      raplcy
    HAVING sum(rrpaym) >=500  -- Only payments exceeding $500
    ;
//
// The rest of this member is a catalogue of the reserved words,
// grouped by the statement each belongs to. Source: Reserved
// words, Db2 for i SQL reference.
//
// Creating a table: column attributes, identity and constraints.
exec sql create table mylib.custmast (
      cusnbr decimal(7, 0) not null
             generated always as identity
             (start with 1 increment by 1 no cycle
              cache 20 no order minvalue 1 maxvalue 9999999),
      cusnam varchar(30) ccsid 37 not null default '',
      cusflg char(1) for sbcs data default null,
      cusdsc graphic(10) ccsid 13488 allocate(20),
      cusntx nvarchar(50), cusncl nclob(1m), cusnch nchar(4),
      cusbin binary(16), cusvbn varbinary(32), cusblb blob(1m),
      cuslng long varchar, cusbool boolean default false,
      cusxml xml, cusrid rowid not null generated by default,
      cushid integer implicitly hidden,
      cusenc varchar(50) inline length 40 fieldproc mylib.fp1,
      constraint cus_pk primary key (cusnbr),
      constraint cus_uq unique (cusnam),
      constraint cus_ck check (cusbal >= 0) enforced enable,
      constraint cus_fk foreign key (cusrgn)
        references mylib.regions (rgncod)
        on delete restrict on update no action)
      rcdfmt custrec;
//
// Physical attributes, partitioning and organisation.
exec sql create table mylib.custhist (like mylib.custmast including identity)
      in database mydb tablespace myts
      partition by range (hstyer)
        (partition p1 starting from (2020) ending at (2024) inclusive,
         partition p2 starting from (2025) ending at (2029) exclusive)
      organize by row
      not logged initially not volatile append on
      data capture none compress yes
      bufferpool bp1 pctfree 10 freepage 4 pagesize 4096
      lockmax 0 locksize row cluster;
//
// Altering, attaching, versioning and dropping.
exec sql alter table mylib.custmast add column cussts char(1) default 'A';
exec sql alter table mylib.custmast alter column cusnam set data type
      varchar(60) not null with default;
exec sql alter table mylib.custmast drop column cushid cascade;
exec sql alter table mylib.custmast add period system_time (sysstt, sysend);
exec sql alter table mylib.custmast add versioning use history table
      mylib.custmast_hist;
exec sql alter table mylib.custhist attach partition p3
      starting from (2030) ending at (2034) from mylib.custnew;
exec sql alter table mylib.custhist detach partition p1 into mylib.custold;
exec sql alter table mylib.custmast activate row access control;
exec sql alter table mylib.custmast deactivate column access control;
exec sql rename table mylib.custold to custarch;
exec sql truncate table mylib.custarch drop storage immediate
      continue identity restrict when delete triggers;
exec sql drop table mylib.custarch restrict;
//
// Views, indexes, aliases, sequences and a query table.
exec sql create view mylib.activecust as
      select cusnbr, cusnam from mylib.custmast
       where cussts = 'A' with cascaded check option;
exec sql create unique index mylib.custix on mylib.custmast
      (cusnam asc, cusnbr desc) add all columns
      where cussts = 'A' minpctused 20 indexbp bp2;
exec sql create alias mylib.cm for mylib.custmast;
exec sql create or replace sequence mylib.ordseq as bigint
      start with 1000 increment by 1 nominvalue nomaxvalue
      nocache nocycle no order;
exec sql create table mylib.custsum as (
      select cusrgn, count_big(*) as n from mylib.custmast
       group by cusrgn)
      data initially deferred refresh deferred
      maintained by user enable query optimization;
exec sql refresh table mylib.custsum;
exec sql comment on table mylib.custmast is 'Customer master';
exec sql label on column mylib.custmast.cusnam is 'Customer name';
//
// Privileges.
exec sql grant select, insert, update (cusnam), delete, alter, index,
      references on table mylib.custmast to public
      with grant option;
exec sql grant createin, usage on schema mylib to user qpgmr;
exec sql revoke all privileges on table mylib.custmast from public
      restrict;
exec sql transfer ownership of table mylib.custmast to user qsecofr
      preserve privileges;
//
// Routines: an external procedure and an SQL function.
exec sql create procedure mylib.logrun (
        in company char(3), inout rows integer, out total decimal(13, 2))
      language cl external name 'MYLIB/LOGRUN'
      parameter style general not deterministic
      modifies sql data fenced threadsafe
      program type main specific logrun1
      dbinfo scratchpad 100 final call
      dynamic result sets 1 old savepoint level
      external action inherit special registers;
exec sql create function mylib.taxof (amount decimal(11, 2))
      returns decimal(11, 2)
      language c external name 'MYLIB/TAXOF'
      parameter style sql deterministic contains sql
      no external action called on null input
      static dispatch;
exec sql create function mylib.custof (rgn char(3))
      returns table (cusnbr decimal(7, 0), cusnam varchar(30))
      language c external name 'MYLIB/CUSTOF'
      parameter style db2sql reads sql data
      disallow parallel cardinality 100;
exec sql create type mylib.money as decimal(11, 2) final
      with comparisons;
exec sql create variable mylib.runmode char(1) default 'P';
exec sql drop specific function mylib.taxof;
//
// Querying: joins, set operators, grouping and predicates.
exec sql select distinct c.cusnbr, r.rgnnam,
           case when c.cusbal > 0 then 'CR' else 'DR' end as sign
      from mylib.custmast c
           inner join mylib.regions r on r.rgncod = c.cusrgn
           left outer join mylib.orders o on o.cusnbr = c.cusnbr
           right join mylib.invoices i on i.cusnbr = c.cusnbr
           full outer join mylib.credits k on k.cusnbr = c.cusnbr
           cross join mylib.calendar
           , lateral (select max(ordamt) from mylib.orders
                       where cusnbr = c.cusnbr) as m(topord)
           , unnest(array[1, 2, 3]) with ordinality as u(v, n)
     where c.cusbal between 100 and 9999
       and c.cusnam like 'A!_%' escape '!'
       and c.cusrgn = some (select rgncod from mylib.regions)
       and c.cusnbr = any (select cusnbr from mylib.orders)
       and exists (select 1 from mylib.orders where cusnbr = c.cusnbr)
       and c.cussts is not null and c.cusflg isnull
       and c.cusdel notnull
       and regexp_like(c.cusnam, '^[A-Z]+$')
       and (c.cusact = true or c.cusold = false or c.cusunk is unknown)
     group by rollup (r.rgnnam, c.cusnbr)
     order by r.rgnnam asc nulls first, 2 desc nulls last
     offset 10 rows fetch first 50 rows only
     with ur;
exec sql select cusnbr from mylib.custmast
     union select cusnbr from mylib.custhist
     except select cusnbr from mylib.custbad
     intersect select cusnbr from mylib.custvip;
exec sql select rgncod, cusrgn, sum(cusbal) from mylib.custmast
     group by cube (rgncod, cusrgn);
exec sql select cusnbr, cusmgr from mylib.custmast
     start with cusmgr is null
     connect by prior cusnbr = cusmgr
     order siblings by cusnbr
     -- connect_by_root cusnam is available here too;
exec sql select connect_by_root cusnam as top from mylib.custmast
     connect by prior cusnbr = cusmgr;
exec sql select cusnbr from mylib.custmast
     where cusbal > 0 limit 25;
//
// Window and ordered-set functions.
exec sql select cusnbr,
           row_number() over (order by cusbal desc) as rn,
           rownumber() over (order by cusbal) as rn2,
           rank() over (partition by cusrgn order by cusbal) as rk,
           dense_rank() over (order by cusbal) as dr,
           denserank() over (order by cusbal) as dr2,
           ntile(4) over (order by cusbal) as quartile,
           lag(cusbal, 1, 0) over (order by cusnbr) as prevbal,
           lead(cusbal, 1) over (order by cusnbr) as nextbal,
           first_value(cusbal) over (order by cusnbr) as firstbal,
           last_value(cusbal) over (order by cusnbr) as lastbal,
           nth_value(cusbal, 2) over (order by cusnbr) as secondbal,
           percent_rank() over (order by cusbal) as pr,
           cume_dist() over (order by cusbal) as cd,
           ratio_to_report(cusbal) over () as share,
           sum(cusbal) over (partition by cusrgn order by cusnbr
                             rows between unbounded preceding
                                       and current row) as running,
           avg(cusbal) over (order by cusnbr
                             range between interval '7' day preceding
                                       and current row) as weekly,
           count(*) over (order by cusnbr groups between 1 preceding
                          and 1 following excluding ties) as near
      from mylib.custmast;
exec sql select cusrgn,
           listagg(cusnam, ', ') within group (order by cusnam) as names,
           array_agg(cusnbr order by cusnbr) as numbers,
           percentile_cont(0.5) within group (order by cusbal) as median,
           percentile_disc(0.9) within group (order by cusbal) as p90,
           xmlagg(xmlelement(name "c", cusnam)) as asxml
      from mylib.custmast group by cusrgn
      having every(cusbal > 0);
//
// Scalar functions, casts and the special values.
exec sql select cast(cusbal as decimal(13, 2)),
           try_cast(cusnam as integer),
           xmlcast(cusxml as varchar(100)),
           extract(year from cusdat), extract(month from cusdat),
           substring(cusnam from 1 for 10),
           position('X' in cusnam),
           overlay(cusnam placing 'Z' from 2 for 1),
           cusnam concat ' ' concat cusrgn,
           trim_array(array[1, 2, 3], 1),
           array_trim(array[1, 2, 3], 1),
           value(cusbal, 0), nullif(cusbal, 0),
           hash(cusnam), hash_row(cusnbr, cusnam),
           hashed_value(cusnbr), rid(c), rrn(c),
           cast(cusnam as character(30) for bit data),
           cast(cusnam as varchar(30) for mixed data),
           normalized cusnam, cusnam is not distinct from 'A'
      from mylib.custmast c
     where cusdbl not in (nan, snan, inf, infinity);
//
// Special registers and sequence values.
exec sql select current_date, current_time, current_timestamp,
           current_path, current_schema, current_server,
           current_timezone, current_user, session_user, system_user,
           user, localdate, localtime, localtimestamp,
           current timestamp with time zone,
           current client_applname, current client_acctng,
           current client_programid, current client_userid,
           current client_wrkstnname, current sqlid,
           current debug mode, current decfloat rounding mode,
           next value for mylib.ordseq, previous value for mylib.ordseq,
           mylib.ordseq.nextval, mylib.ordseq.prevval
      into :regs from sysibm.sysdummy1;
exec sql select cusdat + 1 year + 2 years + 3 month + 4 months
                  + 5 day + 6 days + 7 hour + 8 hours
                  + 9 minute + 10 minutes + 11 second + 12 seconds
                  + 13 microsecond + 14 microseconds
      from mylib.custmast;
//
// JSON.
exec sql select json_object('nbr' value cusnbr, 'nam' value cusnam
                       absent on null returning clob(1k) format json),
           json_array(cusnbr, cusnam null on null),
           json_objectagg(key cusnam value cusbal),
           json_arrayagg(cusnbr order by cusnbr),
           json_value(cusdoc, '$.id' returning integer
                      default 0 on empty null on error),
           json_query(cusdoc, '$.lines' with array wrapper
                      omit quotes keep quotes on scalar string),
           json_to_bson(cusdoc) as asbson
      from mylib.custmast
     where json_exists(cusdoc, '$.id');
exec sql select t.* from mylib.custmast,
           json_table(cusdoc, '$.lines[*]'
                      columns (n for ordinality,
                               item varchar(20) path '$.item',
                               qty integer path '$.qty' error on error)
                      ) as t;
//
// XML.
exec sql select xmlserialize(
             xmlelement(name "cust",
               xmlnamespaces(default 'http://example.com/c',
                             'http://example.com/x' as "x"),
               xmlattributes(cusnbr as "id"),
               xmlforest(cusnam as "name", cusbal as "bal"),
               xmlconcat(xmlcomment('generated'), xmltext(cusnam)),
               xmlpi(name "target", 'value'))
             as clob(1m) version '1.0' including xmldeclaration
             excluding xmlschema),
           xmldocument(xmlelement(name "d")),
           xmlrow(cusnbr, cusnam option row "r"),
           xmlgroup(cusnbr, cusnam option as attributes),
           xmlparse(document cusraw preserve whitespace),
           xmlvalidate(cusxml according to xmlschema uri
                       'http://example.com/s.xsd'
                       location 'schemas' namespace 'urn:c' id sch1),
           xsltransform(cusxml using cusxsl as clob(1m))
      from mylib.custmast;
exec sql select x.* from mylib.custmast,
           xmltable(xmlnamespaces('urn:c' as "c"),
                    '$d/c:lines/c:line' passing cusxml as "d"
                    columns item varchar(20) path '@item') as x;
exec sql drop xsrobject mylib.custschema;
//
// Temporal tables and row access control.
exec sql select cusnam from mylib.custmast
      for system_time as of timestamp '2026-01-01-00.00.00'
     where cusnbr = :custNbr;
exec sql create mask mylib.balmask on mylib.custmast
      for column cusbal return case when 1 = 1 then cusbal
                               else null end enable;
exec sql create permission mylib.rgnperm on mylib.custmast
      for rows where cusrgn = 'EU' enforced for all access enable;
exec sql create secure view mylib.securecust as
      select cusnbr from mylib.custmast;
//
// Cursors with their full set of attributes.
exec sql declare scrollCsr insensitive scroll cursor with hold
      with return to client for
      select cusnbr from mylib.custmast for update of cusbal;
exec sql declare dynCsr sensitive dynamic scroll cursor for
      select cusnbr from mylib.custmast;
exec sql declare asenCsr asensitive cursor for
      select cusnbr from mylib.custmast optimize for 10 rows;
exec sql fetch prior from scrollCsr into :custNbr;
exec sql fetch first from scrollCsr into :custNbr;
exec sql fetch last from scrollCsr into :custNbr;
exec sql fetch absolute 5 from scrollCsr into :custNbr;
exec sql fetch relative -2 from scrollCsr into :custNbr;
exec sql fetch before from scrollCsr into :custNbr;
exec sql fetch after from scrollCsr into :custNbr;
exec sql update mylib.custmast set cusbal = 0
      where current of scrollCsr;
exec sql delete from mylib.custmast where current of scrollCsr;
//
// Dynamic SQL and the descriptor area.
exec sql prepare dynStmt from :stmtText;
exec sql execute dynStmt using :custNbr, :custNm;
exec sql execute immediate :stmtText;
exec sql describe dynStmt into sql descriptor 'DESC1';
exec sql describe input dynStmt using descriptor :sqlda;
exec sql allocate sql descriptor 'DESC1' with max 20;
exec sql get descriptor 'DESC1' :cols = count;
exec sql set descriptor 'DESC1' value 1 data = :custNm;
exec sql deallocate sql descriptor 'DESC1';
exec sql open scrollCsr using descriptor :sqlda;
//
// MERGE, and inserting from a result set.
exec sql merge into mylib.custmast as t
      using (select cusnbr, cusbal from mylib.custfeed) as s
         on t.cusnbr = s.cusnbr
      when matched and s.cusbal = 0 then delete
      when matched then update set t.cusbal = s.cusbal
      when not matched then insert (cusnbr, cusbal)
           overriding user value values (s.cusnbr, s.cusbal)
      else ignore;
exec sql select cusnbr from final table
      (insert into mylib.custmast (cusnam) values ('NEW'));
exec sql select cusnbr from new table
      (update mylib.custmast set cusbal = 0);
exec sql insert into mylib.custmast (cusnbr) values (default)
      -- returning is written on the select above;
//
// Transactions, locking and isolation.
exec sql set transaction isolation level read committed
      no collect statistics;
exec sql lock table mylib.custmast in exclusive mode allow read;
exec sql lock table mylib.custmast in share mode;
exec sql savepoint sp1 unique on rollback retain cursors;
exec sql rollback to savepoint sp1;
exec sql release savepoint sp1;
exec sql commit hold;
exec sql select cusnbr from mylib.custmast
      with rs use and keep exclusive locks
      skip locked data;
exec sql select cusnbr from mylib.custmast
      wait for outcome;
exec sql set current isolation = cs;
//
// Connections.
exec sql connect to :server user :userId using :password;
exec sql connect reset;
exec sql set connection :server;
exec sql disconnect current;
exec sql release all;
//
// Large objects and their locators.
exec sql associate result set locators (:rsLoc)
      with procedure mylib.logrun;
exec sql allocate cursorC cursor for result set :rsLoc;
exec sql free locator :lobLoc;
exec sql hold locator :lobLoc;
exec sql values sqlind_default into :indDefault;
exec sql values sqlind_unassigned into :indUnassigned;
//
// Schemas, packages, plans and other objects.
exec sql create schema mylib authorization qpgmr;
exec sql set schema = mylib;
exec sql set path = mylib, system path;
exec sql create synonym mylib.cust for mylib.custmast;
exec sql drop package mylib.mypkg;
exec sql comment on plan mylib.myplan is 'access plan';
exec sql declare global temporary table session.work
      (n integer) with replace;
exec sql set option datfmt = *iso, naming = *sql, sqlpath = mylib;
//
// Cross-platform storage words the reference reserves.
exec sql create tablespace myts in mydb
      using stogroup mysg priqty 720 secqty 720 vcat mycat
      bufferpool bp1 gbpcache changed pagesize 4k
      piecesize 2g obid 100 lockmax system
      numparts 4 part 1 using stogroup mysg2
      copy yes recovery auto define no
      encryption yes password :password
      linktype url log yes;
exec sql select dbpartitionname(c), dbpartitionnum(c),
           datapartitionname(c), datapartitionnum(c),
           nodename(c), nodenumber(c)
      from mylib.custmast c;
exec sql alter tablespace myts add partition ending at (100);
exec sql select tabname from syscat.tablespaces;
//
// Words the reference reserves in less common clauses.
exec sql create table mylib.opts (n integer)
      ccsid 1208 not logged initially
      with restrict on drop;
exec sql alter table mylib.custmast
      alter foreign key cus_fk enforced
      add constraint chk2 check (cusbal >= 0)
          not enforced trusted enable query optimization;
exec sql call mylib.logrun('EU', :rowsRead, :grandTotal);
exec sql call qsys2.qcmdexc('DSPLIB MYLIB');
exec sql include sqlda;
exec sql select interpret(cusbin as integer) from mylib.custmast;
exec sql select cusnam from mylib.custmast
      for read only with nc;
exec sql select cusnam from mylib.custmast for fetch only;
//
// SQL PL: handlers, autonomous work and the pipelined row.
exec sql create procedure mylib.proc3 () external name 'MYLIB/P3'
      language java parameter style java
      run options 'HEAP(,,,FREE)' wrapped no sql;
exec sql create procedure mylib.proc4 () external name 'MYLIB/P4'
      language c parameter style db2general no sql;
exec sql create procedure mylib.proc7 () external name 'MYLIB/P7'
      language c parameter style db2sql no sql;
exec sql create procedure mylib.proc5 () external name 'MYLIB/P5'
      language cobol parameter style db2genrl no sql;
exec sql create procedure mylib.proc6 () external name 'MYLIB/P6'
      language rpgle parameter style simple call with nulls;
exec sql alter function mylib.taxof secured;
exec sql create function mylib.f2 () returns integer
      language c external name 'MYLIB/F2' variant;
exec sql drop routine mylib.proc2;
exec sql grant execute on routine mylib.proc3 to public;
//
// A recursive query with its search clause.
exec sql with tree (cusnbr, cusmgr, lvl) as (
        select cusnbr, cusmgr, 0 from mylib.custmast
         where cusmgr is null
        union all
        select c.cusnbr, c.cusmgr, t.lvl + 1
          from mylib.custmast c, tree t
         where c.cusmgr = t.cusnbr)
      search depth first by cusnbr set ord
      cycle cusnbr set iscycle to '1' default '0'
    select cusnbr from tree order by ord;
//
// More column and table attributes.
exec sql create table mylib.attrs (
      n integer not null with default,
      d date, t time, ts timestamp without time zone,
      nc national character(10), ncv national char varying(10),
      lob clob(1m) compact not logged,
      dl datalink(200) linktype url file link control
         integrity all read permission db write permission blocked,
      x xml)
      ccsid unicode encoding ebcdic
      definition only;
exec sql create table mylib.likecust like mylib.custmast
      including defaults excluding identity;
exec sql create summary table mylib.custmqt as
      (select cusrgn, count(*) as n from mylib.custmast
        group by cusrgn)
      data initially deferred refresh deferred
      disable query optimization;
exec sql alter table mylib.custsum add materialized query
      (select cusrgn from mylib.custmast)
      data initially deferred refresh deferred;
exec sql create index mylib.ix2 on mylib.custmast (cusnbr)
      not padded defer yes partitioned
      extend using mylib.myextender;
exec sql create table mylib.hashed (n integer)
      partition by hash (n) into 4 partitions;
exec sql alter sequence mylib.ordseq restart with 5000 noorder;
exec sql create sequence mylib.s2 as integer noorder;
exec sql lock table mylib.custmast in share mode
      -- locksize page is a table attribute;
exec sql create table mylib.pg (n integer) locksize page;
exec sql create collection mylib2;
exec sql set integrity for mylib.custmast immediate checked
      for exception in mylib.custmast use mylib.custexc;
exec sql select cusnbr from mylib.custmast
      concurrent access resolution use currently committed;
exec sql set transaction read write;
exec sql create table mylib.app (n integer) append off;
exec sql select xmlparse(content cusraw strip whitespace)
      from mylib.custmast;
exec sql select json_query(cusdoc, '$.a' returning clob format bson)
      from mylib.custmast;
exec sql select t.* from mylib.custmast,
      json_table(cusdoc, '$'
        columns (id integer path '$.id',
                 nested path '$.lines[*]'
                   columns (item varchar(20) path '$.item'))) t;
exec sql select date(cusdat), cast(cusdat as date)
      from mylib.custmast;
exec sql whenever sqlerror go to sqlFail;
