      *
      *Every word in the reserved word list the COBOL grammar carries,
      *written into the statement each belongs to. The statements are
      *the ones the RPGLE catalogue uses, converted to EXEC SQL blocks,
      *so the two catalogues stay parallel and cover the same list.
      *
      *Member: CBLSQLW  Compilable: no (a statement catalogue)
      *Source: Reserved words, Db2 for i SQL reference.
      *Retrieved: 2026-07-29
      *
       IDENTIFICATION DIVISION.
       PROGRAM-ID. CBLSQLW.
       PROCEDURE DIVISION.
       SQL-WORDS.
      *
      *Creating a table: column attributes, identity and constraints.
           EXEC SQL
             create table mylib.custmast ( cusnbr decimal(7, 0) not
             null generated always as identity (start with 1
             increment by 1 no cycle cache 20 no order minvalue 1
             maxvalue 9999999), cusnam varchar(30) ccsid 37 not null
             default '', cusflg char(1) for sbcs data default null,
             cusdsc graphic(10) ccsid 13488 allocate(20), cusntx
             nvarchar(50), cusncl nclob(1m), cusnch nchar(4), cusbin
             binary(16), cusvbn varbinary(32), cusblb blob(1m),
             cuslng long varchar, cusbool boolean default false,
             cusxml xml, cusrid rowid not null generated by default,
             cushid integer implicitly hidden, cusenc varchar(50)
             inline length 40 fieldproc mylib.fp1, constraint cus_pk
             primary key (cusnbr), constraint cus_uq unique (cusnam),
             constraint cus_ck check (cusbal >= 0) enforced enable,
             constraint cus_fk foreign key (cusrgn) references
             mylib.regions (rgncod) on delete restrict on update no
             action) rcdfmt custrec
           END-EXEC.
      *
      *Physical attributes, partitioning and organisation.
           EXEC SQL
             create table mylib.custhist (like mylib.custmast
             including identity) in database mydb tablespace myts
             partition by range (hstyer) (partition p1 starting from
             (2020) ending at (2024) inclusive, partition p2 starting
             from (2025) ending at (2029) exclusive) organize by row
             not logged initially not volatile append on data capture
             none compress yes bufferpool bp1 pctfree 10 freepage 4
             pagesize 4096 lockmax 0 locksize row cluster
           END-EXEC.
      *
      *Altering, attaching, versioning and dropping.
           EXEC SQL
             alter table mylib.custmast add column cussts char(1)
             default 'A'
           END-EXEC.
           EXEC SQL
             alter table mylib.custmast alter column cusnam set data
             type varchar(60) not null with default
           END-EXEC.
           EXEC SQL
             alter table mylib.custmast drop column cushid cascade
           END-EXEC.
           EXEC SQL
             alter table mylib.custmast add period system_time
             (sysstt, sysend)
           END-EXEC.
           EXEC SQL
             alter table mylib.custmast add versioning use history
             table mylib.custmast_hist
           END-EXEC.
           EXEC SQL
             alter table mylib.custhist attach partition p3 starting
             from (2030) ending at (2034) from mylib.custnew
           END-EXEC.
           EXEC SQL
             alter table mylib.custhist detach partition p1 into
             mylib.custold
           END-EXEC.
           EXEC SQL
             alter table mylib.custmast activate row access control
           END-EXEC.
           EXEC SQL
             alter table mylib.custmast deactivate column access
             control
           END-EXEC.
           EXEC SQL
             rename table mylib.custold to custarch
           END-EXEC.
           EXEC SQL
             truncate table mylib.custarch drop storage immediate
             continue identity restrict when delete triggers
           END-EXEC.
           EXEC SQL
             drop table mylib.custarch restrict
           END-EXEC.
      *
      *Views, indexes, aliases, sequences and a query table.
           EXEC SQL
             create view mylib.activecust as select cusnbr, cusnam
             from mylib.custmast where cussts = 'A' with cascaded
             check option
           END-EXEC.
           EXEC SQL
             create unique index mylib.custix on mylib.custmast
             (cusnam asc, cusnbr desc) add all columns where cussts =
             'A' minpctused 20 indexbp bp2
           END-EXEC.
           EXEC SQL
             create alias mylib.cm for mylib.custmast
           END-EXEC.
           EXEC SQL
             create or replace sequence mylib.ordseq as bigint start
             with 1000 increment by 1 nominvalue nomaxvalue nocache
             nocycle no order
           END-EXEC.
           EXEC SQL
             create table mylib.custsum as ( select cusrgn,
             count_big(*) as n from mylib.custmast group by cusrgn)
             data initially deferred refresh deferred maintained by
             user enable query optimization
           END-EXEC.
           EXEC SQL
             refresh table mylib.custsum
           END-EXEC.
           EXEC SQL
             comment on table mylib.custmast is 'Customer master'
           END-EXEC.
           EXEC SQL
             label on column mylib.custmast.cusnam is 'Customer name'
           END-EXEC.
      *
      *Privileges.
           EXEC SQL
             grant select, insert, update (cusnam), delete, alter,
             index, references on table mylib.custmast to public with
             grant option
           END-EXEC.
           EXEC SQL
             grant createin, usage on schema mylib to user qpgmr
           END-EXEC.
           EXEC SQL
             revoke all privileges on table mylib.custmast from
             public restrict
           END-EXEC.
           EXEC SQL
             transfer ownership of table mylib.custmast to user
             qsecofr preserve privileges
           END-EXEC.
      *
      *Routines: an external procedure and an SQL function.
           EXEC SQL
             create procedure mylib.logrun ( in company char(3),
             inout rows integer, out total decimal(13, 2)) language
             cl external name 'MYLIB/LOGRUN' parameter style general
             not deterministic modifies sql data fenced threadsafe
             program type main specific logrun1 dbinfo scratchpad 100
             final call dynamic result sets 1 old savepoint level
             external action inherit special registers
           END-EXEC.
           EXEC SQL
             create function mylib.taxof (amount decimal(11, 2))
             returns decimal(11, 2) language c external name
             'MYLIB/TAXOF' parameter style sql deterministic contains
             sql no external action called on null input static
             dispatch
           END-EXEC.
           EXEC SQL
             create function mylib.custof (rgn char(3)) returns table
             (cusnbr decimal(7, 0), cusnam varchar(30)) language c
             external name 'MYLIB/CUSTOF' parameter style db2sql
             reads sql data disallow parallel cardinality 100
           END-EXEC.
           EXEC SQL
             create type mylib.money as decimal(11, 2) final with
             comparisons
           END-EXEC.
           EXEC SQL
             create variable mylib.runmode char(1) default 'P'
           END-EXEC.
           EXEC SQL
             drop specific function mylib.taxof
           END-EXEC.
      *
      *Querying: joins, set operators, grouping and predicates.
           EXEC SQL
             select distinct c.cusnbr, r.rgnnam, case when c.cusbal >
             0 then 'CR' else 'DR' end as sign from mylib.custmast c
             inner join mylib.regions r on r.rgncod = c.cusrgn left
             outer join mylib.orders o on o.cusnbr = c.cusnbr right
             join mylib.invoices i on i.cusnbr = c.cusnbr full outer
             join mylib.credits k on k.cusnbr = c.cusnbr cross join
             mylib.calendar , lateral (select max(ordamt) from
             mylib.orders where cusnbr = c.cusnbr) as m(topord) ,
             unnest(array[1, 2, 3]) with ordinality as u(v, n) where
             c.cusbal between 100 and 9999 and c.cusnam like 'A!_%'
             escape '!' and c.cusrgn = some (select rgncod from
             mylib.regions) and c.cusnbr = any (select cusnbr from
             mylib.orders) and exists (select 1 from mylib.orders
             where cusnbr = c.cusnbr) and c.cussts is not null and
             c.cusflg isnull and c.cusdel notnull and
             regexp_like(c.cusnam, '^[A-Z]+$') and (c.cusact = true
             or c.cusold = false or c.cusunk is unknown) group by
             rollup (r.rgnnam, c.cusnbr) order by r.rgnnam asc nulls
             first, 2 desc nulls last offset 10 rows fetch first 50
             rows only with ur
           END-EXEC.
           EXEC SQL
             select cusnbr from mylib.custmast union select cusnbr
             from mylib.custhist except select cusnbr from
             mylib.custbad intersect select cusnbr from mylib.custvip
           END-EXEC.
           EXEC SQL
             select rgncod, cusrgn, sum(cusbal) from mylib.custmast
             group by cube (rgncod, cusrgn)
           END-EXEC.
           EXEC SQL
             select cusnbr, cusmgr from mylib.custmast start with
             cusmgr is null connect by prior cusnbr = cusmgr order
             siblings by cusnbr
             -- connect_by_root cusnam is available here too
           END-EXEC.
           EXEC SQL
             select connect_by_root cusnam as top from mylib.custmast
             connect by prior cusnbr = cusmgr
           END-EXEC.
           EXEC SQL
             select cusnbr from mylib.custmast where cusbal > 0 limit
             25
           END-EXEC.
      *
      *Window and ordered-set functions.
           EXEC SQL
             select cusnbr, row_number() over (order by cusbal desc)
             as rn, rownumber() over (order by cusbal) as rn2, rank()
             over (partition by cusrgn order by cusbal) as rk,
             dense_rank() over (order by cusbal) as dr, denserank()
             over (order by cusbal) as dr2, ntile(4) over (order by
             cusbal) as quartile, lag(cusbal, 1, 0) over (order by
             cusnbr) as prevbal, lead(cusbal, 1) over (order by
             cusnbr) as nextbal, first_value(cusbal) over (order by
             cusnbr) as firstbal, last_value(cusbal) over (order by
             cusnbr) as lastbal, nth_value(cusbal, 2) over (order by
             cusnbr) as secondbal, percent_rank() over (order by
             cusbal) as pr, cume_dist() over (order by cusbal) as cd,
             ratio_to_report(cusbal) over () as share, sum(cusbal)
             over (partition by cusrgn order by cusnbr rows between
             unbounded preceding and current row) as running,
             avg(cusbal) over (order by cusnbr range between interval
             '7' day preceding and current row) as weekly, count(*)
             over (order by cusnbr groups between 1 preceding and 1
             following excluding ties) as near from mylib.custmast
           END-EXEC.
           EXEC SQL
             select cusrgn, listagg(cusnam, ', ') within group (order
             by cusnam) as names, array_agg(cusnbr order by cusnbr)
             as numbers, percentile_cont(0.5) within group (order by
             cusbal) as median, percentile_disc(0.9) within group
             (order by cusbal) as p90, xmlagg(xmlelement(name "c",
             cusnam)) as asxml from mylib.custmast group by cusrgn
             having every(cusbal > 0)
           END-EXEC.
      *
      *Scalar functions, casts and the special values.
           EXEC SQL
             select cast(cusbal as decimal(13, 2)), try_cast(cusnam
             as integer), xmlcast(cusxml as varchar(100)),
             extract(year from cusdat), extract(month from cusdat),
             substring(cusnam from 1 for 10), position('X' in
             cusnam), overlay(cusnam placing 'Z' from 2 for 1),
             cusnam concat ' ' concat cusrgn, trim_array(array[1, 2,
             3], 1), array_trim(array[1, 2, 3], 1), value(cusbal, 0),
             nullif(cusbal, 0), hash(cusnam), hash_row(cusnbr,
             cusnam), hashed_value(cusnbr), rid(c), rrn(c),
             cast(cusnam as character(30) for bit data), cast(cusnam
             as varchar(30) for mixed data), normalized cusnam,
             cusnam is not distinct from 'A' from mylib.custmast c
             where cusdbl not in (nan, snan, inf, infinity)
           END-EXEC.
      *
      *Special registers and sequence values.
           EXEC SQL
             select current_date, current_time, current_timestamp,
             current_path, current_schema, current_server,
             current_timezone, current_user, session_user,
             system_user, user, localdate, localtime, localtimestamp,
             current timestamp with time zone, current
             client_applname, current client_acctng, current
             client_programid, current client_userid, current
             client_wrkstnname, current sqlid, current debug mode,
             current decfloat rounding mode, next value for
             mylib.ordseq, previous value for mylib.ordseq,
             mylib.ordseq.nextval, mylib.ordseq.prevval into :regs
             from sysibm.sysdummy1
           END-EXEC.
           EXEC SQL
             select cusdat + 1 year + 2 years + 3 month + 4 months +
             5 day + 6 days + 7 hour + 8 hours + 9 minute + 10
             minutes + 11 second + 12 seconds + 13 microsecond + 14
             microseconds from mylib.custmast
           END-EXEC.
      *
      *JSON.
           EXEC SQL
             select json_object('nbr' value cusnbr, 'nam' value
             cusnam absent on null returning clob(1k) format json),
             json_array(cusnbr, cusnam null on null),
             json_objectagg(key cusnam value cusbal),
             json_arrayagg(cusnbr order by cusnbr),
             json_value(cusdoc, '$.id' returning integer default 0 on
             empty null on error), json_query(cusdoc, '$.lines' with
             array wrapper omit quotes keep quotes on scalar string),
             json_to_bson(cusdoc) as asbson from mylib.custmast where
             json_exists(cusdoc, '$.id')
           END-EXEC.
           EXEC SQL
             select t.* from mylib.custmast, json_table(cusdoc,
             '$.lines[*]' columns (n for ordinality, item varchar(20)
             path '$.item', qty integer path '$.qty' error on error)
             ) as t
           END-EXEC.
      *
      *XML.
           EXEC SQL
             select xmlserialize( xmlelement(name "cust",
             xmlnamespaces(default 'http://example.com/c',
             'http://example.com/x' as "x"), xmlattributes(cusnbr as
             "id"), xmlforest(cusnam as "name", cusbal as "bal"),
             xmlconcat(xmlcomment('generated'), xmltext(cusnam)),
             xmlpi(name "target", 'value')) as clob(1m) version '1.0'
             including xmldeclaration excluding xmlschema),
             xmldocument(xmlelement(name "d")), xmlrow(cusnbr, cusnam
             option row "r"), xmlgroup(cusnbr, cusnam option as
             attributes), xmlparse(document cusraw preserve
             whitespace), xmlvalidate(cusxml according to xmlschema
             uri 'http://example.com/s.xsd' location 'schemas'
             namespace 'urn:c' id sch1), xsltransform(cusxml using
             cusxsl as clob(1m)) from mylib.custmast
           END-EXEC.
           EXEC SQL
             select x.* from mylib.custmast,
             xmltable(xmlnamespaces('urn:c' as "c"),
             '$d/c:lines/c:line' passing cusxml as "d" columns item
             varchar(20) path '@item') as x
           END-EXEC.
           EXEC SQL
             drop xsrobject mylib.custschema
           END-EXEC.
      *
      *Temporal tables and row access control.
           EXEC SQL
             select cusnam from mylib.custmast for system_time as of
             timestamp '2026-01-01-00.00.00' where cusnbr = :custNbr
           END-EXEC.
           EXEC SQL
             create mask mylib.balmask on mylib.custmast for column
             cusbal return case when 1 = 1 then cusbal else null end
             enable
           END-EXEC.
           EXEC SQL
             create permission mylib.rgnperm on mylib.custmast for
             rows where cusrgn = 'EU' enforced for all access enable
           END-EXEC.
           EXEC SQL
             create secure view mylib.securecust as select cusnbr
             from mylib.custmast
           END-EXEC.
      *
      *Cursors with their full set of attributes.
           EXEC SQL
             declare scrollCsr insensitive scroll cursor with hold
             with return to client for select cusnbr from
             mylib.custmast for update of cusbal
           END-EXEC.
           EXEC SQL
             declare dynCsr sensitive dynamic scroll cursor for
             select cusnbr from mylib.custmast
           END-EXEC.
           EXEC SQL
             declare asenCsr asensitive cursor for select cusnbr from
             mylib.custmast optimize for 10 rows
           END-EXEC.
           EXEC SQL
             fetch prior from scrollCsr into :custNbr
           END-EXEC.
           EXEC SQL
             fetch first from scrollCsr into :custNbr
           END-EXEC.
           EXEC SQL
             fetch last from scrollCsr into :custNbr
           END-EXEC.
           EXEC SQL
             fetch absolute 5 from scrollCsr into :custNbr
           END-EXEC.
           EXEC SQL
             fetch relative -2 from scrollCsr into :custNbr
           END-EXEC.
           EXEC SQL
             fetch before from scrollCsr into :custNbr
           END-EXEC.
           EXEC SQL
             fetch after from scrollCsr into :custNbr
           END-EXEC.
           EXEC SQL
             update mylib.custmast set cusbal = 0 where current of
             scrollCsr
           END-EXEC.
           EXEC SQL
             delete from mylib.custmast where current of scrollCsr
           END-EXEC.
      *
      *Dynamic SQL and the descriptor area.
           EXEC SQL
             prepare dynStmt from :stmtText
           END-EXEC.
           EXEC SQL
             execute dynStmt using :custNbr, :custNm
           END-EXEC.
           EXEC SQL
             execute immediate :stmtText
           END-EXEC.
           EXEC SQL
             describe dynStmt into sql descriptor 'DESC1'
           END-EXEC.
           EXEC SQL
             describe input dynStmt using descriptor :sqlda
           END-EXEC.
           EXEC SQL
             allocate sql descriptor 'DESC1' with max 20
           END-EXEC.
           EXEC SQL
             get descriptor 'DESC1' :cols = count
           END-EXEC.
           EXEC SQL
             set descriptor 'DESC1' value 1 data = :custNm
           END-EXEC.
           EXEC SQL
             deallocate sql descriptor 'DESC1'
           END-EXEC.
           EXEC SQL
             open scrollCsr using descriptor :sqlda
           END-EXEC.
      *
      *MERGE, and inserting from a result set.
           EXEC SQL
             merge into mylib.custmast as t using (select cusnbr,
             cusbal from mylib.custfeed) as s on t.cusnbr = s.cusnbr
             when matched and s.cusbal = 0 then delete when matched
             then update set t.cusbal = s.cusbal when not matched
             then insert (cusnbr, cusbal) overriding user value
             values (s.cusnbr, s.cusbal) else ignore
           END-EXEC.
           EXEC SQL
             select cusnbr from final table (insert into
             mylib.custmast (cusnam) values ('NEW'))
           END-EXEC.
           EXEC SQL
             select cusnbr from new table (update mylib.custmast set
             cusbal = 0)
           END-EXEC.
           EXEC SQL
             insert into mylib.custmast (cusnbr) values (default)
             -- returning is written on the select above
           END-EXEC.
      *
      *Transactions, locking and isolation.
           EXEC SQL
             set transaction isolation level read committed no
             collect statistics
           END-EXEC.
           EXEC SQL
             lock table mylib.custmast in exclusive mode allow read
           END-EXEC.
           EXEC SQL
             lock table mylib.custmast in share mode
           END-EXEC.
           EXEC SQL
             savepoint sp1 unique on rollback retain cursors
           END-EXEC.
           EXEC SQL
             rollback to savepoint sp1
           END-EXEC.
           EXEC SQL
             release savepoint sp1
           END-EXEC.
           EXEC SQL
             commit hold
           END-EXEC.
           EXEC SQL
             select cusnbr from mylib.custmast with rs use and keep
             exclusive locks skip locked data
           END-EXEC.
           EXEC SQL
             select cusnbr from mylib.custmast wait for outcome
           END-EXEC.
           EXEC SQL
             set current isolation = cs
           END-EXEC.
      *
      *Connections.
           EXEC SQL
             connect to :server user :userId using :password
           END-EXEC.
           EXEC SQL
             connect reset
           END-EXEC.
           EXEC SQL
             set connection :server
           END-EXEC.
           EXEC SQL
             disconnect current
           END-EXEC.
           EXEC SQL
             release all
           END-EXEC.
      *
      *Large objects and their locators.
           EXEC SQL
             associate result set locators (:rsLoc) with procedure
             mylib.logrun
           END-EXEC.
           EXEC SQL
             allocate cursorC cursor for result set :rsLoc
           END-EXEC.
           EXEC SQL
             free locator :lobLoc
           END-EXEC.
           EXEC SQL
             hold locator :lobLoc
           END-EXEC.
           EXEC SQL
             values sqlind_default into :indDefault
           END-EXEC.
           EXEC SQL
             values sqlind_unassigned into :indUnassigned
           END-EXEC.
      *
      *Schemas, packages, plans and other objects.
           EXEC SQL
             create schema mylib authorization qpgmr
           END-EXEC.
           EXEC SQL
             set schema = mylib
           END-EXEC.
           EXEC SQL
             set path = mylib, system path
           END-EXEC.
           EXEC SQL
             create synonym mylib.cust for mylib.custmast
           END-EXEC.
           EXEC SQL
             drop package mylib.mypkg
           END-EXEC.
           EXEC SQL
             comment on plan mylib.myplan is 'access plan'
           END-EXEC.
           EXEC SQL
             declare global temporary table session.work (n integer)
             with replace
           END-EXEC.
           EXEC SQL
             set option datfmt = *iso, naming = *sql, sqlpath = mylib
           END-EXEC.
      *
      *Cross-platform storage words the reference reserves.
           EXEC SQL
             create tablespace myts in mydb using stogroup mysg
             priqty 720 secqty 720 vcat mycat bufferpool bp1 gbpcache
             changed pagesize 4k piecesize 2g obid 100 lockmax system
             numparts 4 part 1 using stogroup mysg2 copy yes recovery
             auto define no encryption yes password :password
             linktype url log yes
           END-EXEC.
           EXEC SQL
             select dbpartitionname(c), dbpartitionnum(c),
             datapartitionname(c), datapartitionnum(c), nodename(c),
             nodenumber(c) from mylib.custmast c
           END-EXEC.
           EXEC SQL
             alter tablespace myts add partition ending at (100)
           END-EXEC.
           EXEC SQL
             select tabname from syscat.tablespaces
           END-EXEC.
      *
      *Words the reference reserves in less common clauses.
           EXEC SQL
             create table mylib.opts (n integer) ccsid 1208 not
             logged initially with restrict on drop
           END-EXEC.
           EXEC SQL
             alter table mylib.custmast alter foreign key cus_fk
             enforced add constraint chk2 check (cusbal >= 0) not
             enforced trusted enable query optimization
           END-EXEC.
           EXEC SQL
             call mylib.logrun('EU', :rowsRead, :grandTotal)
           END-EXEC.
           EXEC SQL
             call qsys2.qcmdexc('DSPLIB MYLIB')
           END-EXEC.
           EXEC SQL
             include sqlda
           END-EXEC.
           EXEC SQL
             select interpret(cusbin as integer) from mylib.custmast
           END-EXEC.
           EXEC SQL
             select cusnam from mylib.custmast for read only with nc
           END-EXEC.
           EXEC SQL
             select cusnam from mylib.custmast for fetch only
           END-EXEC.
      *
      *SQL PL: handlers, autonomous work and the pipelined row.
           EXEC SQL
             create procedure mylib.proc3 () external name 'MYLIB/P3'
             language java parameter style java run options
             'HEAP(,,,FREE)' wrapped no sql
           END-EXEC.
           EXEC SQL
             create procedure mylib.proc4 () external name 'MYLIB/P4'
             language c parameter style db2general no sql
           END-EXEC.
           EXEC SQL
             create procedure mylib.proc7 () external name 'MYLIB/P7'
             language c parameter style db2sql no sql
           END-EXEC.
           EXEC SQL
             create procedure mylib.proc5 () external name 'MYLIB/P5'
             language cobol parameter style db2genrl no sql
           END-EXEC.
           EXEC SQL
             create procedure mylib.proc6 () external name 'MYLIB/P6'
             language rpgle parameter style simple call with nulls
           END-EXEC.
           EXEC SQL
             alter function mylib.taxof secured
           END-EXEC.
           EXEC SQL
             create function mylib.f2 () returns integer language c
             external name 'MYLIB/F2' variant
           END-EXEC.
           EXEC SQL
             drop routine mylib.proc2
           END-EXEC.
           EXEC SQL
             grant execute on routine mylib.proc3 to public
           END-EXEC.
      *
      *A recursive query with its search clause.
           EXEC SQL
             with tree (cusnbr, cusmgr, lvl) as ( select cusnbr,
             cusmgr, 0 from mylib.custmast where cusmgr is null union
             all select c.cusnbr, c.cusmgr, t.lvl + 1 from
             mylib.custmast c, tree t where c.cusmgr = t.cusnbr)
             search depth first by cusnbr set ord cycle cusnbr set
             iscycle to '1' default '0' select cusnbr from tree order
             by ord
           END-EXEC.
      *
      *More column and table attributes.
           EXEC SQL
             create table mylib.attrs ( n integer not null with
             default, d date, t time, ts timestamp without time zone,
             nc national character(10), ncv national char
             varying(10), lob clob(1m) compact not logged, dl
             datalink(200) linktype url file link control integrity
             all read permission db write permission blocked, x xml)
             ccsid unicode encoding ebcdic definition only
           END-EXEC.
           EXEC SQL
             create table mylib.likecust like mylib.custmast
             including defaults excluding identity
           END-EXEC.
           EXEC SQL
             create summary table mylib.custmqt as (select cusrgn,
             count(*) as n from mylib.custmast group by cusrgn) data
             initially deferred refresh deferred disable query
             optimization
           END-EXEC.
           EXEC SQL
             alter table mylib.custsum add materialized query (select
             cusrgn from mylib.custmast) data initially deferred
             refresh deferred
           END-EXEC.
           EXEC SQL
             create index mylib.ix2 on mylib.custmast (cusnbr) not
             padded defer yes partitioned extend using
             mylib.myextender
           END-EXEC.
           EXEC SQL
             create table mylib.hashed (n integer) partition by hash
             (n) into 4 partitions
           END-EXEC.
           EXEC SQL
             alter sequence mylib.ordseq restart with 5000 noorder
           END-EXEC.
           EXEC SQL
             create sequence mylib.s2 as integer noorder
           END-EXEC.
           EXEC SQL
             lock table mylib.custmast in share mode
             -- locksize page is a table attribute
           END-EXEC.
           EXEC SQL
             create table mylib.pg (n integer) locksize page
           END-EXEC.
           EXEC SQL
             create collection mylib2
           END-EXEC.
           EXEC SQL
             set integrity for mylib.custmast immediate checked for
             exception in mylib.custmast use mylib.custexc
           END-EXEC.
           EXEC SQL
             select cusnbr from mylib.custmast concurrent access
             resolution use currently committed
           END-EXEC.
           EXEC SQL
             set transaction read write
           END-EXEC.
           EXEC SQL
             create table mylib.app (n integer) append off
           END-EXEC.
           EXEC SQL
             select xmlparse(content cusraw strip whitespace) from
             mylib.custmast
           END-EXEC.
           EXEC SQL
             select json_query(cusdoc, '$.a' returning clob format
             bson) from mylib.custmast
           END-EXEC.
           EXEC SQL
             select t.* from mylib.custmast, json_table(cusdoc, '$'
             columns (id integer path '$.id', nested path
             '$.lines[*]' columns (item varchar(20) path '$.item')))
             t
           END-EXEC.
           EXEC SQL
             select date(cusdat), cast(cusdat as date) from
             mylib.custmast
           END-EXEC.
           EXEC SQL
             whenever sqlerror go to sqlFail
           END-EXEC.
