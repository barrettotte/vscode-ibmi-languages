{
  // VS Code looks up keyword brackets in lowercase, even for uppercase or
  // mixed-case source. Keep these entries lowercase.
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],

    ["if", "endif"],
    ["if", "end"],
    ["ifeq", "endif"],
    ["ifeq", "end"],
    ["ifge", "endif"],
    ["ifge", "end"],
    ["ifgt", "endif"],
    ["ifgt", "end"],
    ["ifle", "endif"],
    ["ifle", "end"],
    ["iflt", "endif"],
    ["iflt", "end"],
    ["ifne", "endif"],
    ["ifne", "end"],

    ["dow", "enddo"],
    ["dow", "end"],
    ["doweq", "enddo"],
    ["doweq", "end"],
    ["dowge", "enddo"],
    ["dowge", "end"],
    ["dowgt", "enddo"],
    ["dowgt", "end"],
    ["dowle", "enddo"],
    ["dowle", "end"],
    ["dowlt", "enddo"],
    ["dowlt", "end"],
    ["downe", "enddo"],
    ["downe", "end"],

    ["dou", "enddo"],
    ["dou", "end"],
    ["doueq", "enddo"],
    ["doueq", "end"],
    ["douge", "enddo"],
    ["douge", "end"],
    ["dougt", "enddo"],
    ["dougt", "end"],
    ["doule", "enddo"],
    ["doule", "end"],
    ["doult", "enddo"],
    ["doult", "end"],
    ["doune", "enddo"],
    ["doune", "end"],

    ["do", "enddo"],
    ["do", "end"],

    // package.json excludes SQL keyword and identifier scopes from RPG matching.
    ["select", "endsl"],
    ["select", "end"],

    ["for-each", "endfor"],
    ["for-each", "end"],
    ["for", "endfor"],
    ["for", "end"],

    ["begsr", "endsr"],
    ["monitor", "endmon"],
    ["dcl-ds", "end-ds"],
    ["dcl-enum", "end-enum"],
    ["dcl-proc", "end-proc"],
    ["dcl-pr", "end-pr"],
    ["dcl-pi", "end-pi"],

    // /IF and /FREE boundaries can cross RPG blocks. Giving the directives
    // their own bracket pairs would break those matches; see tests/README.md.

    // Match END-EXEC as a whole so its END cannot close an outer RPG block.
    ["exec sql", ";"],
    ["exec sql", "end-exec"]
  ],
  // symbols that are auto closed when typing
  "autoClosingPairs": [
    //["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  // symbols that that can be used to surround a selection
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "comments": {
    "lineComment": "//"
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
